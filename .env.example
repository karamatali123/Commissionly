# Production origin, no trailing slash. Used for canonical tags, sitemap, and redirects.
NEXT_PUBLIC_SITE_URL=https://www.commissionly.cc

# Optional Google Search Console meta verification token.
NEXT_PUBLIC_GSC_VERIFICATION=d6jdLEDWNqEae5mCmze71lcyQdhIHBZwJ3_3RB9p31c

# Shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Formspree form id. Leave blank to show the email address only.
NEXT_PUBLIC_FORMSPREE_ID=

# Gumroad or Lemon Squeezy URL for the spreadsheet template.
NEXT_PUBLIC_TEMPLATE_URL=

# Set to "true" to reserve ad slots and allow an AdSense script after consent.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# Plausible domain, without https. Loaded only after the visitor accepts cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
